            Bytes done{ProbeDone};u64(done,id);u64(done,sent);u64(done,uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(Clock::now()-began).count()));c.enqueue(std::move(done));
        }catch(...){/* Diagnostic failure cannot terminate the desktop process. */}
    });}catch(...){c.probe_finished=true;--probe_count;SecureZeroMemory(key.data(),key.size());return false;}
    SecureZeroMemory(key.data(),key.size());return true;
}
