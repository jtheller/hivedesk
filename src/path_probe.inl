// Included inside Transport::Impl. The probe carries generated bytes only;
// it never starts capture, a viewer, clipboard exchange or input authority.
std::atomic<unsigned> probe_count{0};
static void record_probe(Conn::ProbeReceiver& receiver,uint32_t sequence,uint32_t bytes){
    if(sequence>=receiver.seen.size()||receiver.seen[sequence])return;
    receiver.seen[sequence]=true;++receiver.result.received_packets;receiver.result.received_bytes+=bytes;
    const auto now=transport_us();if(!receiver.first_us)receiver.first_us=now;receiver.last_us=now;
}
bool dispatch_probe(Conn& c,uint8_t type,Reader& r){
    if(!(c.peer.features&FeaturePathProbe))return false;
    const auto id=r.qword();if(!id)return false;
    if(type==ProbePayload){
        const auto sequence=r.dword();if(!r.good||r.b.size()-r.at!=1200)return false;
        auto control=find(c.peer.id);if(!control)return true;
        std::lock_guard lock(control->probe_mutex);
        if(auto receiver=control->probe_receiver;receiver&&receiver->id==id)record_probe(*receiver,sequence,1200);
        return true;
    }
