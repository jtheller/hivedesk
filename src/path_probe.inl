        const auto port=r.word();if(!r.end())return false;
        std::lock_guard lock(c.probe_mutex);
        if(auto receiver=c.probe_receiver;receiver&&receiver->id==id){receiver->ready=true;receiver->port=port;}
        return true;
    }
    if(type==ProbeDone){
        const auto sent=r.qword(),elapsed=r.qword();if(!r.end()||sent>25000||elapsed>20000000)return false;
        std::lock_guard lock(c.probe_mutex);
        if(auto receiver=c.probe_receiver;receiver&&receiver->id==id){receiver->done=true;receiver->result.sent_packets=sent;receiver->result.source_elapsed_us=elapsed;}
        return true;
    }
    const auto mode=r.byte();const auto port=r.word();const auto bitrate=r.dword(),duration=r.dword();Key key{};
    if(!r.good||r.b.size()-r.at!=key.size()||mode>1||bool(port)!=bool(mode)||bitrate<100000||bitrate>20000000||duration<1000||duration>10000)return false;
    std::copy_n(r.b.begin()+r.at,key.size(),key.begin());
    if(!c.probe_finished)return true;
    // At most two bounded generated senders across authenticated connections.
    if(probe_count.fetch_add(1)>=2){--probe_count;return true;}
    if(c.probe_worker.joinable())c.probe_worker.join();c.probe_finished=false;
    try{c.probe_worker=std::thread([this,&c,id,mode,port,bitrate,duration,key]()mutable{
        struct Finish{Impl& owner;Conn& c;Key& key;~Finish(){SecureZeroMemory(key.data(),key.size());c.probe_finished=true;--owner.probe_count;}} finish{*this,c,key};
        struct SocketOwner{SOCKET s=INVALID_SOCKET;~SocketOwner(){if(s!=INVALID_SOCKET)closesocket(s);}} udp;
        try{
            sockaddr_in remote{};remote.sin_family=AF_INET;remote.sin_port=htons(port);
            if(inet_pton(AF_INET,c.peer.address.c_str(),&remote.sin_addr)!=1)return;
            uint16_t local_port=0;
            if(mode){
                udp.s=::socket(AF_INET,SOCK_DGRAM,IPPROTO_UDP);sockaddr_in local{};local.sin_family=AF_INET;int size=sizeof(local);DWORD timeout=100;
                if(inet_pton(AF_INET,c.local_ipv4().c_str(),&local.sin_addr)!=1)return;
                if(udp.s==INVALID_SOCKET||bind(udp.s,reinterpret_cast<sockaddr*>(&local),sizeof(local))||getsockname(udp.s,reinterpret_cast<sockaddr*>(&local),&size))return;
                setsockopt(udp.s,SOL_SOCKET,SO_SNDTIMEO,reinterpret_cast<char*>(&timeout),sizeof(timeout));local_port=ntohs(local.sin_port);
            }
            Bytes ready{ProbeReady};u64(ready,id);u16(ready,local_port);if(!c.enqueue(std::move(ready)))return;
            if(mode)sendto(udp.s,reinterpret_cast<const char*>(key.data()),int(key.size()),0,reinterpret_cast<sockaddr*>(&remote),sizeof(remote));
            // Allow authenticated port exchange and reciprocal permission before
            // counting traffic. This is startup allowance, not media buffering.
            const auto start=Clock::now()+std::chrono::milliseconds(800);
            while(running&&!c.closed&&Clock::now()<start)std::this_thread::sleep_for(std::chrono::milliseconds(2));
            const auto began=Clock::now(),end=began+std::chrono::milliseconds(duration);
            FrameTimer timer;
            auto due=began;const auto interval=std::chrono::nanoseconds(1200ull*8*1000000000/bitrate);
            uint32_t sent=0;
            auto video=find(c.peer.id,true);if(!mode&&!video)return;
            while(running&&!c.closed&&Clock::now()<end&&sent<25000){
                const auto now=Clock::now();if(now<due){timer.wait_until(std::min(due,now+std::chrono::milliseconds(1)));continue;}
                if(!mode){std::lock_guard lock(video->queue_mutex);if(!video->ready||video->closed)break;if(!video->video_credit||video->video){due=Clock::now();}}
                if(!mode){bool credit;{std::lock_guard lock(video->queue_mutex);credit=video->video_credit&&!video->video;}if(!credit){timer.wait_until(Clock::now()+std::chrono::milliseconds(1));continue;}}
                Bytes packet;if(!mode)packet.push_back(ProbePayload);u64(packet,id);u32(packet,sent);
                const auto prefix=packet.size();packet.resize(prefix+1200);
                if(!random_bytes(packet.data()+prefix,1200))break; // Incompressible on both transports.
                bool accepted=false;
                if(mode){Key tag{};if(!hmac(key,packet,tag))break;packet.insert(packet.end(),tag.begin(),tag.end());
                    accepted=sendto(udp.s,reinterpret_cast<const char*>(packet.data()),int(packet.size()),0,reinterpret_cast<sockaddr*>(&remote),sizeof(remote))==int(packet.size());}
