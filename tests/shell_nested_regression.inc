void Shell::nested_return_self_test(){
    auto& s=*impl_;
    const auto require=[](bool ok,const char* why){if(!ok)throw std::runtime_error(why);};
    USEROBJECTFLAGS flags{};DWORD bytes=0;
    require(GetUserObjectInformationW(GetProcessWindowStation(),UOI_FLAGS,&flags,sizeof(flags),&bytes)&&!(flags.dwFlags&WSF_VISIBLE),"Nested regression requires isolated station");
    auto saved=s.callbacks;const auto peers=s.peers;
    struct Cleanup{Impl& s;ShellCallbacks callbacks;std::vector<Peer> peers;~Cleanup(){s.local(false);s.callbacks=std::move(callbacks);s.peers=std::move(peers);}} cleanup{s,saved,peers};
    unsigned closes=0,sends=0;ReturnRequest sent;ReturnReply reply;
    s.callbacks.return_local=[&]{++closes;};
    s.callbacks.return_request=[&](const std::string&,const ReturnRequest& r){++sends;sent=r;return true;};
    s.callbacks.return_reply=[&](const std::string&,const ReturnReply& r){reply=r;return true;};
    const auto viewing=[&](uint64_t session){
        s.local(false);s.end_peek(false);s.taskbar_focus_guard=false;
        s.peers={{"nested-child","Child","",47980,true,FeatureNestedReturn}};
        ++s.generation;s.selection_armed=true;s.remote=true;s.active_id=s.pending_id="nested-child";s.input_session=session;s.publish_input();
    };
    viewing(11);s.return_begin();require(s.nested_return.busy()&&s.input_state().local_shell,"pending return did not yield input authority");
    const auto first=sent;s.return_begin();require(sends==1,"rapid repeat queued another unwind");
    returned("nested-child",{11,first.id,ReturnResult::Returned});
    require(closes==0&&s.remote&&!s.nested_return.busy()&&!s.input_state().local_shell,"successful child unwind also closed parent or stranded input");
    s.return_begin();returned("nested-child",{11,sent.id,ReturnResult::Leaf});
    require(closes==1&&!s.remote&&s.input_session==0,"leaf return did not release local viewer");
    viewing(12);bool authorized=true;
    return_one("parent",{77,1,15},[&]{return authorized;});const auto old=sent;
    authorized=false;returned("nested-child",{12,old.id,ReturnResult::Leaf});
    require(closes==1&&s.remote&&reply.result==ReturnResult::Stale,"revoked inbound controller closed a viewer");
    authorized=true;return_one("parent",{77,2,15},[&]{return authorized;});
    const auto old2=sent;++s.generation;
    returned("nested-child",{12,old2.id,ReturnResult::Leaf});
    require(closes==1&&reply.result==ReturnResult::Stale,"queued reply closed a new generation");
    const auto count=sends;return_one("parent",{77,2,15},[]{return true;});
    require(sends==count&&reply.result==ReturnResult::Stale,"duplicate command restarted an unwind");
    return_one("parent",{77,3,0},[]{return true;});require(reply.result==ReturnResult::Limit&&s.remote,"hop limit closed a view");
    return_one("parent",{77,4,15},[]{return true;});
    return_one("cycle",{88,1,14},[]{return true;});require(reply.result==ReturnResult::Busy,"cycle was not bounded by busy admission");
    const auto pending=sent;s.local(true);
    returned("nested-child",{12,pending.id,ReturnResult::Leaf});require(closes==2&&!s.remote,"late reply repeated emergency return");
    return_one("parent",{77,5,15},[]{return true;});require(reply.result==ReturnResult::Leaf&&closes==2,"leaf node unwound inbound stream");
    viewing(13);s.peers[0].features=0;s.return_begin();require(closes==3&&!s.remote,"legacy boundary lost old local escape");
    viewing(0);s.return_begin();require(closes==4&&!s.remote,"connecting selection could not be cancelled");
    viewing(14);s.return_begin();
    s.return_complete(s.nested_return.tick(GetTickCount64()+10001,s.return_view(),true));
    require(s.remote&&!s.nested_return.busy()&&!s.input_state().local_shell&&closes==4,"timeout closed or stranded outer desktop");
    // Summon follows the active child while preserving every viewer. Return
    // replies cannot complete a summon, even with a matching numeric identity.
    viewing(15);s.peers[0].features|=FeatureRemoteHive;
    s.toggle_panel();require(s.panel_mode==2,"outer Hive fixture did not open");
    SendMessageW(s.owner,WM_HOTKEY,83,0);const auto summon=sent;
    require(s.panel_closing,"outer Hive covered summoned child Hive");
    require(summon.summon&&s.nested_return.busy()&&s.input_state().returning,"remote shortcut did not enter ordered operation");
    returned("nested-child",{15,summon.id,ReturnResult::Leaf});require(s.nested_return.busy(),"return reply completed a summon");
    returned("nested-child",{15,summon.id,ReturnResult::Returned,true});
    require(s.remote&&closes==4&&!s.nested_return.busy(),"summon closed a viewer or left input blocked");
    return_one("parent",{77,6,15,true},[]{return true;});const auto forwarded=sent;
    require(forwarded.summon&&forwarded.hops==14,"remote summon lost mode or hop bound");
    returned("nested-child",{15,forwarded.id,ReturnResult::Returned,true});
    require(reply.summon&&reply.id==6&&reply.session==77&&reply.result==ReturnResult::Returned&&closes==4,"summon result did not return to parent");
    s.peers[0].features=FeatureNestedReturn;const auto before_legacy=sends;
    s.return_begin({}, {},true);require(s.remote&&sends==before_legacy&&!s.nested_return.busy(),"legacy summon closed viewer or waited indefinitely");
    s.local(false);s.hide_panel(false);
    return_one("parent",{77,7,15,true},[]{return false;});require(!s.panel_mode&&reply.result==ReturnResult::Stale,"revoked summon opened local Hive");
    return_one("parent",{77,8,15,true},[]{return true;});require(s.panel_mode==2&&s.panel_summoned&&reply.summon&&reply.result==ReturnResult::Returned,"leaf summon did not show local Hive");
    s.hide_panel(false);return_one("parent",{77,8,15,true},[]{return true;});require(!s.panel_mode,"duplicate summon reopened Hive");
    SendMessageW(s.owner,WM_HOTKEY,83,0);require(s.panel_mode==2&&s.panel_summoned,"remote shortcut without viewer did not show local Hive");
    SendMessageW(s.owner,WM_HOTKEY,83,0);require(s.panel_closing,"second remote shortcut did not dismiss local Hive");s.hide_panel(false);
    viewing(16);s.peers[0].features|=FeatureCompactStats;
    require(!s.compact_stats,"stats did not default off");
    s.config.desktop.debug_overlay=true;
    SendMessageW(s.owner,WM_HOTKEY,84,0);require(!s.compact_stats&&s.config.desktop.debug_overlay,"stats shortcut changed debug or saved stats");
    s.config.desktop.debug_overlay=false;SendMessageW(s.owner,WM_HOTKEY,84,0);require(s.compact_stats,"stats did not resume after debug disabled");
    s.config.desktop.debug_overlay=true;s.stats_unavailable(L"test");require(s.detailed_hud(),"notice displaced detailed debug");
    SendMessageW(s.owner,WM_HOTKEY,84,0);require(s.compact_stats,"debug shortcut mutated enabled stats");
    s.config.desktop.debug_overlay=false;s.hud_notice_until=0;
    s.bind_stats("another-device");require(!s.compact_stats,"Stats carried into another device");
    s.bind_stats(s.active_id);require(s.compact_stats,"Stats did not restore for original device");
    s.callbacks.save_stats=[](const auto&){return false;};s.toggle_stats();require(s.compact_stats,"Failed save changed stats choice");s.callbacks.save_stats={};
    require(s.stats_draggable(),"Normal stats cannot be dragged");
    s.stats_unavailable(L"test");require(!s.stats_draggable(),"Error badge can be dragged");s.hud_notice_until=0;
    s.config.desktop.debug_overlay=true;require(!s.stats_draggable(),"Detailed debug can be dragged as compact HUD");s.config.desktop.debug_overlay=false;
    s.reconnecting=true;require(!s.stats_draggable(),"Reconnect badge can be dragged");s.reconnecting=false;
    SendMessageW(s.owner,WM_HOTKEY,84,0);require(!s.compact_stats,"local stats shortcut did not hide");
    SendMessageW(s.owner,WM_HOTKEY,85,0);const auto stat_request=sent;
    require(stat_request.stats&&!stat_request.summon&&s.nested_return.busy(),"deep stats did not use ordered operation");
    returned("nested-child",{16,stat_request.id,ReturnResult::Leaf,false,true});
    require(s.compact_stats&&s.remote&&!s.nested_return.busy(),"last viewer did not toggle without closing");
    returned("nested-child",{16,stat_request.id,ReturnResult::Leaf,false,true});require(s.compact_stats,"duplicate stats reply toggled twice");
    s.toggle_stats();return_one("parent",{77,9,15,false,true},[]{return true;});const auto forwarded_stats=sent;
    returned("nested-child",{16,forwarded_stats.id,ReturnResult::Returned,false,true});
    require(!s.compact_stats&&reply.stats&&reply.result==ReturnResult::Returned,"intermediate stats toggled outer HUD");
    return_one("parent",{77,10,15,false,true},[]{return false;});require(!s.compact_stats&&reply.result==ReturnResult::Stale,"unauthorized stats toggled HUD");
    s.peers[0].features=FeatureNestedReturn;const auto before_stats=sends;
    SendMessageW(s.owner,WM_HOTKEY,85,0);require(sends==before_stats&&s.remote&&!s.nested_return.busy(),"old peer stats did not fail closed");
    s.local(false);return_one("parent",{77,11,15,false,true},[]{return true;});
    require(!s.compact_stats&&reply.stats&&reply.result==ReturnResult::Leaf,"leaf stats toggled a nonexistent view");
    viewing(15);s.windowed=true;s.remote_width=1920;s.remote_height=1080;
    SetWindowPos(s.viewer,HWND_TOP,300,200,800,500,SWP_SHOWWINDOW);SetForegroundWindow(s.viewer);s.publish_input();
    auto relay_state=s.input_state();relay_state.remote=true;s.input_capture.update(relay_state);
    const auto bounds=s.viewer_client();const POINT center{(bounds.left+bounds.right)/2,(bounds.top+bounds.bottom)/2};
    const auto absolute=[&](POINT p){return InputEvent{InputKind::Absolute,int32_t((int64_t(p.x)*65536)/GetSystemMetrics(SM_CXSCREEN)),int32_t((int64_t(p.y)*65536)/GetSystemMetrics(SM_CYSCREEN))};};
    auto mapped=route_remote(501,absolute(center),true,true);
    require(mapped.forward&&mapped.local&&std::abs(mapped.event.a-32768)<300&&std::abs(mapped.event.b-32768)<300,"Nested window center/letterbox coordinate mapping");
    // Local broker positioning has not run. Button hit testing must use the
    // preceding authenticated absolute packet, not the old Windows cursor.
    mapped=route_remote(501,{InputKind::Button,1,0},true,true);require(mapped.forward&&!mapped.local,"Nested button used stale intermediate OS position");
    mapped=route_remote(501,absolute({0,0}),true,true);require(mapped.forward&&mapped.event.a==0&&mapped.event.b==0,"Nested drag escaped its captured viewer");
    mapped=route_remote(501,{InputKind::Button,1,1},true,true);require(mapped.forward&&!mapped.local,"Nested drag release lost outside window");
    mapped=route_remote(501,absolute({0,0}),true,true);require(!mapped.forward&&mapped.local,"Local desktop pointer forwarded to nested viewer");
    mapped=route_remote(501,{InputKind::Key,30,0},false,true);require(!mapped.forward&&mapped.local,"Secure desktop input forwarded behind lock screen");
    route_remote(501,{InputKind::ReleaseAll},true,true);s.windowed=false;
    s.local(false);s.hide_panel(false);
    const auto order=s.config.device_order;
    struct RestoreOrder{Impl& s;std::vector<std::string> order;~RestoreOrder(){s.config.device_order=std::move(order);}} restore_order{s,order};
    s.config.device_order={"ancestor","ordinary"};
    const std::vector<Peer> all{{"ordinary","Ordinary","",47980,true,FeatureWarmStream|FeatureLivePeek},{"ancestor","Ancestor","",47980,true,FeatureWarmStream|FeatureLivePeek}};
    unsigned chosen=0,paused=0;
    s.callbacks.select_peer=[&](const std::string&){++chosen;};
    s.callbacks.peek_peer=[&](const std::string& id,uint64_t){if(id.empty())++paused;};
    s.callbacks.visible_peers=[](const auto&){};
    update_peers(all);s.show_panel(2);s.hover_peek(1);
    const auto old_epoch=s.peek_epoch;s.pressed_card=1;s.dragged_peer="ancestor";
    update_peers({all[0]});
    require(s.peers.size()==1&&s.peers[0].id=="ordinary"&&s.peek_id.empty()&&s.peek_epoch>old_epoch&&paused&&s.pressed_card<0,"Hidden ancestor retained hover/drag/Peek authority");
    require(std::find(s.warm_visible.begin(),s.warm_visible.end(),"ancestor")==s.warm_visible.end(),"Hidden ancestor retained warm visibility");
    s.select("ancestor");s.select("ancestor",true);
    require(!chosen,"Hidden ancestor selectable by stale fullscreen/window action");
    update_peers(all);require(s.peers[0].id=="ancestor"&&s.config.device_order==std::vector<std::string>({"ancestor","ordinary"}),"Restored ancestor lost saved position");
    s.hide_panel(false);

}
